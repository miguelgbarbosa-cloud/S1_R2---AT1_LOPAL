    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;digitar um valor: &quot;" newline="True"/>
            <declare name="n&#250;mero" type="Real" array="False" size=""/>
            <input variable="n&#250;mero"/>
            <if expression="n&#250;mero =0">
                <then>
                    <output expression="&quot;Seu n&#250;mero &#233; zero. &quot;" newline="True"/>
                </then>
                <else>
                    <if expression="n&#250;mero &gt;0">
                        <then>
                            <output expression="&quot;Seu n&#250;mero &#233; positivo. &quot;" newline="True"/>
                        </then>
