    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="primeiro" type="Real" array="False" size=""/>
            <output expression="&quot;digite o primeiro valor. &quot;" newline="True"/>
            <input variable="primeiro"/>
            <declare name="segundo" type="Real" array="False" size=""/>
            <output expression="&quot;digite o segundo numero. &quot;" newline="True"/>
