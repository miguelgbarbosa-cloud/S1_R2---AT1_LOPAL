    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;me informe a nota de suas provas&quot;" newline="True"/>
            <output expression="&quot;nota da primeira prova&quot;" newline="True"/>
            <declare name="primeira" type="Real" array="False" size=""/>
            <input variable="primeira"/>
            <output expression="&quot;me informe a nota da segunda prova&quot;" newline="True"/>
            <declare name="segunda" type="Real" array="False" size=""/>
            <input variable="segunda"/>
            <declare name="media" type="Real" array="False" size=""/>
            <assign variable="media" expression="(primeira+segunda)/2"/>
            <output expression="&quot;sua media &#233;: &quot; &amp; media" newline="True"/>
        </body>
    </function>
